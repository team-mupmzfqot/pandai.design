{
  // Pandai live feedback wall — Cloudflare Worker + Durable Object (WebSocket Hibernation + SQLite)
  "name": "pandai-product",
  "main": "src/index.js",
  "compatibility_date": "2025-05-01",

  "durable_objects": {
    "bindings": [
      { "name": "BOARD", "class_name": "Board" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Board"] }
  ],

  "observability": { "enabled": true }

  // Optional moderation: set a secret so /admin can delete / clear notes:
  //   npx wrangler secret put ADMIN_TOKEN
}
